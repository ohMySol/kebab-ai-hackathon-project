# Copy to .env and fill in. Never commit .env.
# Token Factory API key (not the Cloud login, not a promo code).
NEBIUS_API_KEY=__SET_ME__
# Tavily API key.
TAVILY_API_KEY=__SET_ME__
# Jury login for the app.
APP_USERNAME=jury
APP_PASSWORD=__SET_ME__
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
# Optional full organizer CSV path. Leave empty to auto-detect data/private/*.csv or use the sample.
SUPPLIER_CSV=
